# Sao chép file này thành .env khi chạy trên máy tính.
# Trên Render: nhập các biến này ở mục Environment, KHÔNG đẩy file .env lên GitHub.

# Supabase → Project Settings → API (hoặc API Keys)
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# Khoá bí mật: "service_role" (legacy) hoặc "secret" (sb_secret_...). KHÔNG dùng khoá anon/publishable.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# Chuỗi ngẫu nhiên dài để ký token đăng nhập. Tạo bằng:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=doi-chuoi-nay-thanh-chuoi-ngau-nhien-dai

# true  = ai cũng tự đăng ký được (người đăng ký ĐẦU TIÊN trở thành admin)
# false = chỉ admin tạo tài khoản (vẫn cho đăng ký khi hệ thống chưa có ai)
ALLOW_REGISTER=true

# Số ngày giữ lịch sử cảm biến (dữ liệu cũ hơn tự xoá để không đầy gói Free 500 MB)
RETENTION_DAYS=90

# Thiết bị được coi là "trực tuyến" nếu đồng bộ trong vòng N giây
ONLINE_WINDOW_SEC=30

PORT=3000
